<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pentateuch.Absyn\Pentateuch.Absyn.csproj" />
  </ItemGroup>

  <!-- Roslyn (all three must stay on the same version) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Input for the Roslyn test in Program.cs; copied next to the program when it builds -->
    <None Update="schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
