<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="GenesysServicesHost.AuthenticationType" value="GENESYS"/>
    <add key="GenesysServicesHost.LDAPPath" value=""/>
    <add key="LoggingLogLevel" value="Error"/>
    <add key="Cache.ScavengeThreshold" value="1073741824"/>
    <add key="Cache.ScavengeInterval" value="10000"/>
    <add key="Cache.ScavengeAmount" value="5000"/>
    <add key="Events.HeartbeatInterval" value="300000"/>
    <add key="SessionManagement.HeartbeatPeriod" value="30000"/>
    <add key="Activation.Server.Host" value="genesysactivation.vitechcorp.com"/>
    <add key="Activation.Server.Port" value="443"/>
    <add key="ProductCode" value="G01"/>
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>
