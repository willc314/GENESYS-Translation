<Window x:Class="EntityViewerWPF.EntityViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EntityViewerWPF"
    Title="Entity Viewer" Height="509" Width="752"
    Background="AliceBlue" WindowStartupLocation="CenterScreen" >
    
    <Window.Resources>
        <local:AttributeValueConverter x:Key="attributeValueConverter" />
        
        <Style x:Key="ListBoxHighlight" TargetType="ListBoxItem">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="DarkBlue"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" HorizontalAlignment="Stretch" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <Label Grid.Row="0" Grid.Column="0">Project:</Label>
            
            <Grid Grid.Row="0" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="txtProject" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="Auto" Margin="4" IsEnabled="False"/>
                <Button x:Name="btnOpenProject" Click="btnOpenProject_Click" Grid.Column="1" Margin="3" Height="25" Width="50">Open</Button>
            </Grid>

            <Label Grid.Row="1" Grid.Column="0">Folder:</Label>

            <Grid Grid.Row="1" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="cmbFolders" DisplayMemberPath="Name" Grid.Row="0" Grid.Column="0" Height="Auto" Margin="4" VerticalAlignment="Top" SelectionChanged="cmbFolders_SelectionChanged" />
                <Button x:Name="btnNewEntity" Click="btnNewEntity_Click" Grid.Column="1" Margin="3" Height="25" Width="50" ToolTip="Create a new Entity in the selected folder.">New</Button>
            </Grid>
        </Grid>

        <ListBox x:Name="lstEntities" Grid.Row="1" Margin="3" ItemContainerStyle="{StaticResource ListBoxHighlight}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                    <Border x:Name="listItemBorder" BorderThickness="2" BorderBrush="DarkBlue" CornerRadius="5" HorizontalAlignment="Stretch" Margin="5" >
                        
                        <Border.Background>
                            <LinearGradientBrush>
                                <GradientStop Color="AliceBlue" Offset="0" />
                                <GradientStop Color="White" Offset="0.5" />
                                <GradientStop Color="AliceBlue" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Grid Height="100" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="400"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="{Binding Converter={StaticResource attributeValueConverter}, ConverterParameter=number}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource attributeValueConverter}, ConverterParameter=name}" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource attributeValueConverter}, ConverterParameter=description}" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        
                    </Border>
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
