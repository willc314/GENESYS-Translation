<Window x:Class="EntityViewerWPF.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Login" Height="257" Width="361" ResizeMode="NoResize" Opacity="1" WindowStartupLocation="CenterScreen">
    <Grid Margin="3,3,3,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="5" >
            <TextBlock Height="35" FontSize="24" >Entity Viewer</TextBlock>
            <TextBlock>Sample API Application</TextBlock>
        </StackPanel>
        
        <Rectangle Grid.Row="1" Margin="5,0,5,0">
            <Rectangle.Fill>
                <LinearGradientBrush>
                    <GradientStop Color="White" Offset="0" />
                    <GradientStop Color="Red" Offset="0.5" />
                    <GradientStop Color="White" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <Grid Grid.Row="2" Height="65" Width="300">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Label Grid.Column="0" Grid.Row="0">User Name:</Label>
            <Label Grid.Column="0" Grid.Row="1">Password:</Label>
            
            <TextBox Text="Administrator" Opacity="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="0" Margin="4" Name="txtUsername" Height="Auto" />
            <PasswordBox Opacity="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" Margin="4" Name="txtPassword" Height="Auto" />
        </Grid>
        
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Width="170">
            <Button x:Name="btnLogin" IsDefault="True" Width="75" Margin="3" Click="btnLogin_Click">Login</Button>
            <Button x:Name="btnCancel" IsCancel="True" Width="75" Margin="3" Click="btnCancel_Click">Cancel</Button>
        </StackPanel>
        
    </Grid>
</Window>
