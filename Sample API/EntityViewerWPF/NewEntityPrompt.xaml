<Window x:Class="EntityViewerWPF.NewEntityPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Entity" Height="144" Width="349" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0" Margin="2">
            <Label Content="Name:         " />
            <TextBox x:Name="txtName" Width="250" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="1" Margin="2">
            <Label Content="Description:"/>
            <TextBox x:Name="txtDescription" Width="250" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Margin="2">
            <Button x:Name="btnOk" Width="75" Margin="2" Click="btnOk_Click" IsDefault="True">Ok</Button>
            <Button x:Name="btnCancel" Width="75" Margin="2" Click="btnCancel_Click" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
