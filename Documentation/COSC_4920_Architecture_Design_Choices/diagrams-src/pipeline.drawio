          <mxGeometry x="600" y="105" width="180" height="68" as="geometry" />
        </mxCell>
        <mxCell id="mm" value="Model Mapper&#xa;CA-2: entities and relationships" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="270" width="180" height="68" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="GENESYS Repository&#xa;entities, not pictures" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="600" y="275" width="180" height="58" as="geometry" />
