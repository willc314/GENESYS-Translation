  <diagram name="The Translation Pipeline (Pipe and Filter)" id="pipeline">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="frame" value="The Translation Pipeline (Pipe and Filter)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=310;height=30;verticalAlign=middle;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="810" height="520" as="geometry" />
