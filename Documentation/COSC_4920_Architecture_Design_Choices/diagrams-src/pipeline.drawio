        <mxCell id="n1" value="Each filter performs one transformation and passes the result on. The pipes are labelled with" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="127.05" y="386" width="595.9" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="the format carried, because an agreed transfer format is the named cost of this pattern." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="142.8" y="405" width="564.4" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="AC-n runs the same pipe in the opposite direction, reusing every filter." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="193.2" y="439" width="463.6" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="SA-n and AS-n are shorter pipes whose two ends are both the GENESYS repository." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="171.15" y="457" width="507.7" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Adding Visual Basic adds one filter at the left-hand end and changes nothing downstream." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="142.8" y="491" width="564.4" height="18" as="geometry" />
