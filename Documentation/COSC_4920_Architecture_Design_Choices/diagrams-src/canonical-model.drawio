        <mxCell id="n1" value="Each representation knows only the canonical form, never the one at the far end." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
