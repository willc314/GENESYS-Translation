        <mxCell id="n3" value="Absyn belongs to neither the language nor the model, which is also why it targets" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
