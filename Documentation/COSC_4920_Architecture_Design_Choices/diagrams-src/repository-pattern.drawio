        <mxCell id="n1" value="No component talks to another. Every view regenerates from the repository on demand." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="155.4" y="471" width="539.2" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="That is why CM-5 and C-6 hold: our output is complete once the entities exist, and the tool" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=none;strokeColor=none;" vertex="1" parent="1">
